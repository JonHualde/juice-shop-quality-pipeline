{
  "name": "juice-shop-quality-pipeline",
  "version": "1.0.0",
  "description": "Automated QA pipeline for OWASP Juice Shop with API and E2E quality gates.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "newman run postman/collections/juice-shop-quality-pipeline.postman_collection.json --environment postman/environments/local-juice-shop.postman_environment.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "report:e2e": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "newman": "^6.2.2",
    "typescript": "^7.0.2"
  }
}
