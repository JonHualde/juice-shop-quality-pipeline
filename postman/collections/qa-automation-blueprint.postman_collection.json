{
  "info": {
    "_postman_id": "81730bc0-2559-408f-97e6-47625f975035",
    "name": "QA Automation Blueprint API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "13669350"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Get registration security question @api @setup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "",
                  "const body = pm.response.json();",
                  "const question = body.data.find(({ question }) => question === \"Your favorite book?\");",
                  "",
                  "pm.test(\"Security questions are available\", () => pm.expect(body.data).to.be.an(\"array\").and.not.be.empty);",
                  "pm.test(\"Stable registration question exists\", () => pm.expect(question).to.be.an(\"object\"));",
                  "",
                  "pm.environment.set(\"securityQuestionId\", question.id);",
                  "pm.environment.set(\"securityQuestionText\", question.question);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SecurityQuestions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SecurityQuestions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register unique test user @api @setup @critical",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = `${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;",
                  "pm.environment.set(\"testUserEmail\", `qa.blueprint.${runId}@example.com`);",
                  "pm.environment.set(\"testUserPassword\", `QaBlueprint_${runId}!`);",
                  "pm.environment.set(\"securityQuestionAnswer\", `blueprint-${runId}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Registration succeeds\", () => pm.expect(body.status).to.eql(\"success\"));",
                  "pm.test(\"Created identity is usable\", () => {",
                  "  pm.expect(body.data.id).to.be.a(\"number\");",
                  "  pm.expect(body.data.email).to.eql(pm.environment.get(\"testUserEmail\"));",
                  "  pm.expect(body.data.role).to.eql(\"customer\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"passwordRepeat\": \"{{testUserPassword}}\",\n  \"securityQuestion\": {\n    \"id\": {{securityQuestionId}},\n    \"question\": \"{{securityQuestionText}}\"\n  },\n  \"securityAnswer\": \"{{securityQuestionAnswer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Users"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login succeeds @api @critical @smoke",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Authentication exists\", () => pm.expect(body.authentication).to.be.an(\"object\"));",
                  "pm.test(\"Token is non-empty\", () => pm.expect(body.authentication.token).to.be.a(\"string\").and.not.be.empty);",
                  "pm.test(\"Identity and basket are valid\", () => {",
                  "  pm.expect(body.authentication.umail).to.eql(pm.environment.get(\"testUserEmail\"));",
                  "  pm.expect(body.authentication.bid).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/rest/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rest",
                "user",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login is rejected @api @critical @regression",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Content-Type is HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
                  "",
                  "const body = pm.response.text();",
                  "pm.test(\"Invalid credentials are rejected\", () => pm.expect(body).to.eql(\"Invalid email or password.\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"wrongPassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/rest/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rest",
                "user",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
